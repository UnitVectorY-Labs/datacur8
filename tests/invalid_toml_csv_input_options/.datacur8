version: "0.0.0"
types:
  - name: records
    input: toml
    csv: {delimiter: "\t"}
    match:
      include: ['^data/.*\.csv$']
    schema:
      type: object
      properties:
        id: {type: string}
        active: {type: boolean}
        count: {type: integer}
    output:
      format: toml
      path: out/nested/records.toml
